OPENAI_API_KEY=sk-...

# Models per role (all default to the cheapest model)
COMPILER_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna
FAST_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EFFORT_FAST=low
EFFORT_COMPILER=medium

# Prices in USD per 1M tokens, used for cost in the app and registered with Langfuse
MODEL_PRICES={"gpt-6-luna": {"input": 0.10, "cached_input": 0.10, "output": 0.50}}

# Langfuse (self-hosted by docker compose on :3000, sign-up disabled). Required: compose creates the admin
# user and project keys from these on Langfuse's first start.
LANGFUSE_ADMIN_EMAIL=admin@portdues.local
LANGFUSE_ADMIN_PASSWORD=change-me
LANGFUSE_PUBLIC_KEY=pk-lf-portdues-local
LANGFUSE_SECRET_KEY=sk-lf-portdues-local
# only when running the api outside docker (make langfuse + make api)
LANGFUSE_HOST=http://localhost:3000

# Ingestion: "auto" sends only pages with tables/figures to the vision model
VISION_PAGES=auto
LLM_CONCURRENCY=8

# Laya scorer (needs the laya package; set false to skip)
LAYA_ENABLED=true

# Local development only (docker compose sets these itself)
DATABASE_URL=postgresql://portdues:portdues@localhost:5434/portdues
QDRANT_URL=http://localhost:6333
